/dts-v1/;

#include <dt-bindings/clock/rockchip,rk3588-cru.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/gpio-keys.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include <dt-bindings/usb/pd.h>
#include "rk3588.dtsi"

/ {
	model = "Skysi X5 Laptop";
	compatible = "rockchip,rk3588-yourland", "rockchip,rk3588-arm-pc", "rockchip,rk3588";
	chassis-type = "laptop";

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
		mmc2 = &sdio;
		serial2 = &uart2;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		brightness-levels = <0 255>;
		default-brightness-level = <200>;
		enable-gpios = <&gpio4 RK_PB5 GPIO_ACTIVE_HIGH>;
		num-interpolated-steps = <255>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_backlight_en>;
		power-supply = <&vcc3v3_lcd>;
		pwms = <&pwm15 0 25000 0>;
	};

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <6000000>;
		constant-charge-current-max-microamp = <5000000>;
		constant-charge-voltage-max-microvolt = <8700000>;
		voltage-max-design-microvolt = <8700000>;
		voltage-min-design-microvolt = <7600000>;
		power-supplies = <&dc_charger &bq257xx_charger>;
	};

	dc_charger: dc-charger {
		compatible = "gpio-charger";
		charger-type = "mains";
		charge-current-limit-default-microamp = <5000000>;
		gpios = <&gpio0 RK_PD1 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&dc_det>;
		wakeup-source;
	};
/*
	es7243e_sound: dmic-sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "rk3588-dmic";
		simple-audio-card,mclk-fs = <256>;
		#sound-dai-cells = <0>; 

		simple-audio-card,cpu {
			bitclock-master;
			frame-master;
			sound-dai = <&i2s2_2ch>;
		};

		simple-audio-card,codec {
			sound-dai = <&es7243e>;
		};
	};
*/
	es8326_sound: es8326-sound {
		compatible = "audio-graph-card";
		label = "rk3588-es8326";

		widgets =
			"Headphone", "Headphones",
			"Speaker", "Speakers",
			"Microphone", "Headset Mic",
			"Microphone", "Main Mic";

		routing =
			"Headphones", "HPOL",
			"Headphones", "HPOR",
			"Speakers", "HPOL",
			"Speakers", "HPOR",
			"MIC1", "Headset Mic",
			"MIC2", "Main Mic";

		dais = <&i2s0_8ch_p0>;
		hp-det-gpios = <&gpio1 RK_PD0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&hp_det>;
	};

	spk_enable_reg: regulator-spk-enable {
		compatible = "regulator-fixed";
		regulator-name = "spk_power";
		gpio = <&gpio2 RK_PB7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	fan: pwm-fan {
		compatible = "pwm-fan";
		cooling-levels = <0 120 150 180 210 240 255>;
		fan-supply = <&vcc5v0_sys>;
		pwms = <&pwm13 0 50000 0>;
		#cooling-cells = <2>;
	};

	gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&sw_lid>;

		switch-lid {
			debounce-interval = <20>;
			gpios = <&gpio0 RK_PD2 GPIO_ACTIVE_LOW>;
			label = "Lid";
			linux,code = <SW_LID>;
			linux,input-type = <EV_SW>;
			wakeup-source;
		};
	};

	gpio_leds: gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&leds_gpio>;

		charge_indicator: led1 {
			color = <LED_COLOR_ID_GREEN>;
			default-state = "off";
			gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_HIGH>;
			label = "battery_full";
			linux,default-trigger = "cw2017-battery-full";
			retain-state-suspended;
		};

		power_indicator: led2 {
			color = <LED_COLOR_ID_WHITE>;
			default-state = "off";
			gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_HIGH>;
			label = "battery_charging";
			linux,default-trigger = "cw2017-battery-charging";
			retain-state-suspended;
		};
	};

	hdmi0-con {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi0_con_in: endpoint {
				remote-endpoint = <&hdmi0_out_con>;
			};
		};
	};

	combophy_avdd0v85: regulator-combophy-avdd0v85 {
		compatible = "regulator-fixed";
		regulator-name = "combophy_avdd0v85";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <850000>;
		vin-supply = <&vdd_0v85_s0>;
	};

	combophy_avdd1v8: regulator-combophy-avdd1v8 {
		compatible = "regulator-fixed";
		regulator-name = "combophy_avdd1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&avcc_1v8_s0>;
	};

	vbus5v0_typec: regulator-vbus5v0-typec {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio1 RK_PB5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vbus5v0_typec_en>;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "vbus5v0_typec";
		vin-supply = <&vcc5v0_sys>;
	};

	vcc12v_dcin: regulator-vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		regulator-name = "vcc12v_dcin";
	};

	vcc3v3_lcd: regulator-vcc3v3-lcd {
		compatible = "regulator-fixed";
		regulator-boot-on;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "vcc3v3_lcd";
		vin-supply = <&vcc_3v3_s0>;

		regulator-state-mem {
			// Screen power off in suspend state
			regulator-off-in-suspend;
		};
	};

	vcc3v3_pcie30: regulator-vcc3v3-pcie30 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc3v3_pcie30_en>;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "vcc3v3_pcie30";
		startup-delay-us = <5000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_host: regulator-vcc5v0-host {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio4 RK_PC3 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_host_en>;
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "vcc5v0_host";
		vin-supply = <&vcc5v0_usb>;
	};

	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "vcc5v0_sys";
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_usb: regulator-vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "vcc5v0_usb";
		vin-supply = <&vcc5v0_usbdcin>;
	};

	vcc5v0_usbdcin: regulator-vcc5v0-usbdcin {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "vcc5v0_usbdcin";
		vin-supply = <&vcc12v_dcin>;
	};

	usb1_enable: regulator-usb1-enable {
		compatible = "regulator-fixed";
		regulator-name = "usb1_enable";
		gpio = <&gpio3 RK_PD2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	usb2_enable: regulator-usb2-enable {
		compatible = "regulator-fixed";
		regulator-name = "usb2_enable";
		gpio = <&gpio2 RK_PB5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	wifi_vbat: regulator-wifi-vbat {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_poweren_gpio>;
		regulator-always-on;
		regulator-boot-on;
		regulator-name = "wifi_vbat";
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rtc>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		/*
		 * On the module itself this is one of these (depending
		 * on the actual card populated):
		 * - SDIO_RESET_L_WL_REG_ON
		 * - PDN (power down when low)
		 */
		post-power-on-delay-ms = <200>;
		reset-gpios = <&gpio0 RK_PC7 GPIO_ACTIVE_LOW>;
	};
};

&cpu_b0 {
	cpu-supply = <&vdd_cpu_big0_s0>;
};

&cpu_b1 {
	cpu-supply = <&vdd_cpu_big0_s0>;
};

&cpu_b2 {
	cpu-supply = <&vdd_cpu_big1_s0>;
};

&cpu_b3 {
	cpu-supply = <&vdd_cpu_big1_s0>;
};

&cpu_l0 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l1 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l2 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l3 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&dp0 {
	status = "okay";
};

&dp0_in {
	dp0_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_dp0>;
	};
};

&dp0_out {
	dp0_out_con: endpoint {
		remote-endpoint = <&usbdp_phy0_dp_in>;
	};
};

&edp1 {
	force-hpd;
	status = "okay";

	aux-bus {
		panel {
			/* Autual panel is AUO B140HAN04.0, EDID timing not applicable
			   compatible with this BOE panel, bpc must set to 8 */
			compatible = "boe,nv140fhmn49";
			enable-gpios = <&gpio1 RK_PC4 GPIO_ACTIVE_HIGH>;
			backlight = <&backlight>;
			power-supply = <&vcc3v3_lcd>;
			no-hpd;

			port {
				panel_in_edp1: endpoint {
					remote-endpoint = <&edp1_out_panel>;
				};
			};
		};
	};
};

&edp1_in {
	edp1_in_vp2: endpoint {
		remote-endpoint = <&vp2_out_edp1>;
	};
};

&edp1_out {
	edp1_out_panel: endpoint {
		remote-endpoint = <&panel_in_edp1>;
	};
};

&gpu {
	mali-supply = <&vdd_gpu_s0>;
	sram-supply = <&vdd_gpu_mem_s0>;
	status = "okay";
};

&hdmi0 {
	frl-enable-gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&hdmi_en &hdmim0_tx0_hpd
		     &hdmim0_tx0_scl &hdmim0_tx0_sda>;
	status = "okay";
};

&hdmi0_in {
	hdmi0_in_vp1: endpoint {
		remote-endpoint = <&vp1_out_hdmi0>;
	};
};

&hdmi0_out {
	hdmi0_out_con: endpoint {
		remote-endpoint = <&hdmi0_con_in>;
	};
};

&hdmi0_sound {
	status = "okay";
};

/* HDMI0/eDP0 Combo PHY, used as hdmi0 */
&hdptxphy0 {
	status = "okay";
};

/* HDMI1/eDP1 Combo PHY, used as edp1 */
&hdptxphy1 {
	status = "okay";
};

&i2c2 {
	i2c-scl-rising-time-ns = <600>;
	i2c-scl-falling-time-ns = <20>;
	status = "okay";

	cw2017@63 {
		compatible = "cellwise,cw2017";
		reg = <0x63>;

		cellwise,battery-profile = <
			0x32000000 0x00000000 0xa2bfc9f0 0xacb19755 0x42ffffff
			0xe0b39080 0x604a2480 0xacd995d3 0xd1cfcfcc 0xc9abee99
			0xbab7bb9f 0x8c817468 0x5b5d6f8a 0xa08f573d 0x00009002
			0x00000000 0x00006400 0x00000000 0x00000000 0x00000079
		>;

		cellwise,alert-level = <10>;
		cellwise,design-capacity-amh = <6000>;
		cellwise,dual-cell;
		cellwise,monitor-interval-ms = <3000>;
		monitored-battery = <&battery>;
		power-supplies = <&dc_charger &bq257xx_charger>;
		status = "okay";
	};

	bq257xx_charger: sc8886@6b {
		compatible = "ti,bq25703a";
		reg = <0x6b>;

		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD0 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&charger_int_h &otg_enable_h>;

		input-current-limit-microamp = <5000000>;
		monitored-battery = <&battery>;
		power-supplies = <&usbc0>;

		regulators {
			usb_otg_vbus: vbus {
				enable-gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_HIGH>;
				regulator-max-microamp = <3000000>;
				regulator-min-microamp = <512000>;
				regulator-name = "usb_otg_vbus";
			};
		};
	};

	usbc0: fusb302@22 {
		compatible = "fcs,fusb302";
		reg = <0x22>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usbc0_int>;
		vbus-supply = <&vbus5v0_typec>;
		status = "okay";

		usb_con: connector {
			compatible = "usb-c-connector";
			data-role = "dual";
			label = "USB-C";
			/* fusb302 supports PD Rev 2.0 Ver 1.2 */
			pd-revision = /bits/ 8 <0x2 0x0 0x1 0x2>;
			op-sink-microwatt = <1000000>;
			power-role = "dual";
			sink-pdos =
				<PDO_FIXED(5000, 1000, PDO_FIXED_USB_COMM)
				 PDO_FIXED(15000, 3000, PDO_FIXED_USB_COMM)>;
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
			try-power-role = "sink";

			altmodes {
				displayport {
					svid = /bits/ 16 <0xff01>;
					vdo = <0xffffffff>;
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					usbc0_hs: endpoint {
						remote-endpoint = <&usb_host0_xhci_hs>;
					};
				};

				port@1 {
					reg = <1>;
					usbc0_ss: endpoint {
						remote-endpoint = <&usbdp_phy0_ss_out>;
					};
				};

				port@2 {
					reg = <2>;
					usbc0_sbu: endpoint {
						remote-endpoint = <&usbdp_phy0_dp_out>;
					};
				};
			};
		};
	};

	/* AiP8563 RTC */
	rtc: aip8563@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-output-names = "hym8563";
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD4 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&rtc_int>;
		wakeup-source;
	};
};

&i2c3 {
	status = "okay";
/*
	es7243e: audio-adc@10 {
		compatible = "everest,es7243e";
		reg = <0x10>;
		clocks = <&cru I2S0_8CH_MCLKOUT>;
		clock-names = "mclk";
		#sound-dai-cells = <0>;

		work-mode = <0>;
		mclk-lrck-ratio = <256>;
		data-length = <0>;
		mclk-source = <1>;
		pga-gain-db = <9>;
	};
*/
	es8326: audio-codec@19 {
		compatible = "everest,es8326";
		reg = <0x19>;
		clocks = <&cru I2S0_8CH_MCLKOUT>;
		clock-names = "mclk";
		assigned-clocks = <&cru I2S0_8CH_MCLKOUT>;
		assigned-clock-rates = <12288000>;
		#sound-dai-cells = <0>;

		//interrupt-parent = <&gpio1>;
		//interrupts = <RK_PD0 GPIO_ACTIVE_LOW>;
		mic1-src = <22>;
		mic2-src = <44>;
		jack-pol = <07>;

		port {
			es8326_p0_0: endpoint {
				remote-endpoint = <&i2s0_8ch_p0_0>;
			};
		};
	};
};

/* for kaihong botbook only */
&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m3_xfer>;
	status = "okay";

	touchpad: touchpad@2c {
		compatible = "hid-over-i2c";
		reg = <0x2c>;
		pinctrl-names = "default";
		pinctrl-0 = <&tp_reset_gpio &tp_irq_gpio>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD5 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpio1 RK_PA6 GPIO_ACTIVE_LOW>;
		hid-descr-addr = <0x20>;
		wakeup-source;
	};
};

/* I2S0 - ES8326 Audio Codec */
&i2s0_8ch {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s0_lrck &i2s0_sclk &i2s0_sdi0 &i2s0_sdi1 &i2s0_sdi2 &i2s0_sdo0>;
	status = "okay";

	i2s0_8ch_p0: port {
		i2s0_8ch_p0_0: endpoint {
			dai-format = "i2s";
			mclk-fs = <256>;
			remote-endpoint = <&es8326_p0_0>;
		};
	};
};

/*
&i2s2_2ch {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s2m0_sclk &i2s2m0_lrck &i2s2m0_sdi &i2s2m0_sdo>;
	status = "okay";
};
*/

/* HDMI0 audio */
&i2s5_8ch {
	status = "okay";
};

&pcie30phy {
	status = "okay";
};

/* PCIe 3.0 x4 NVme SSD */
&pcie3x4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie3x4_rst>;
	reset-gpios = <&gpio1 RK_PB2 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie30>;
	status = "okay";
};

&pdm1{
	pinctrl-names = "default";
	pinctrl-0 = <&pdm1m1_clk &pdm1m1_sdi0>;
	pinctrl-1 = <&pdm1m1_idle>;
	pinctrl-2 = <&pdm1m1_clk &pdm1m1_clk1>;
	status = "okay";
};

&pinctrl {
	audio {
		hp_det: hp-det {
			rockchip,pins = <1 RK_PD0 RK_FUNC_GPIO &pcfg_pull_down>;
		};

		spk_amp_enable_h: spk-amp-enable-h {
			rockchip,pins = <2 RK_PB7 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};

	bluetooth {
		bt_reset_gpio: bt-reset-gpio {
			rockchip,pins = <3 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_wake_gpio: bt-wake-gpio {
			rockchip,pins = <4 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_irq_gpio: bt-irq-gpio {
			rockchip,pins = <3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	charger {
		charger_int_h: charger-int-h {
			rockchip,pins = <0 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		dc_det: dc-det {
			rockchip,pins = <0 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		otg_enable_h: otg-enable-h {
			rockchip,pins = <3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	display {
		hdmi_en: hdmi-en {
			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_output_high>;
		};

		lcd_backlight_en: lcd-backlight-en {
			rockchip,pins = <4 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	gpio-keys {
		sw_lid: sw-lid {
			rockchip,pins = <0 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	gpio-leds {
		leds_gpio: leds-gpio {
			rockchip,pins = <3 RK_PC1 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};

	rtc {
		rtc_int: rtc-int {
			rockchip,pins = <0 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	pcie3 {
		pcie3x4_rst: pcie3x4-rst {
			rockchip,pins = <1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		vcc3v3_pcie30_en: vcc3v3-pcie30-en {
			rockchip,pins = <3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	toudchpad {
		tp_irq_gpio: pen-int-odl {
			rockchip,pins = <0 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		tp_reset_gpio: pen-reset-l {
			rockchip,pins = <1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		vcc5v0_host_en: vcc5v0-host-en {
			rockchip,pins = <4 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>,
					<2 RK_PB6 RK_FUNC_GPIO &pcfg_output_high>,
					<3 RK_PC0 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};

	usb-typec {
		usbc0_int: usbc0-int {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		usbc0_sbu1: usbc0-sbu1 {
			rockchip,pins = <4 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		usbc0_sbu2: usbc0-sbu2 {
			rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		vbus5v0_typec_en: vbus5v0-typec-en {
			rockchip,pins = <1 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_down>;
		};

		wifi_poweren_gpio: wifi-poweren-gpio {
			rockchip,pins = <3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&pwm13 {
	pinctrl-0 = <&pwm13m1_pins>;
	status = "okay";
};

&pwm15 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm15m1_pins>;
	status = "okay";
};

&rknn_core_0 {
	npu-supply = <&vdd_npu_s0>;
	sram-supply = <&vdd_npu_mem_s0>;
	status = "okay";
};

&rknn_core_1 {
	npu-supply = <&vdd_npu_s0>;
	sram-supply = <&vdd_npu_mem_s0>;
	status = "okay";
};

&rknn_core_2 {
	npu-supply = <&vdd_npu_s0>;
	sram-supply = <&vdd_npu_mem_s0>;
	status = "okay";
};

&rknn_mmu_0 {
	status = "okay";
};

&rknn_mmu_1 {
	status = "okay";
};

&rknn_mmu_2 {
	status = "okay";
};

&saradc {
	vref-supply = <&vcc_1v8_s0>;
	status = "okay";
};

/* eMMC */
&sdhci {
	bus-width = <8>;
	max-frequency = <200000000>;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";
};

/* WiFi */
&sdio {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdiom1_pins>;

	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	disable-wp;
	keep-power-in-suspend;
	max-frequency = <150000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	no-mmc;
	non-removable;
	no-sd;
	sd-uhs-sdr104;
	status = "okay";

	brcmf: wifi@1 {
		compatible = "brcm,bcm43752-fmac";
		reg = <1>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC4 IRQ_TYPE_LEVEL_HIGH>;	/* WL_HOST_WAKE */
		interrupt-names = "host-wake";
		pinctrl-0 = <&wifi_host_wake_irq>;
		pinctrl-names = "default";
	};
};

/* Micro SD Card */
&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
	disable-wp;
	max-frequency = <150000000>;
	no-sdio;
	no-mmc;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_bus4 &sdmmc_clk &sdmmc_cmd &sdmmc_det>;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_3v3_s3>;
	vqmmc-supply = <&vccio_sd_s0>;
	status = "okay";
};

&sfc {
	pinctrl-names = "default";
	pinctrl-0 = <&fspim1_pins>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0x0>;
		spi-max-frequency = <108000000>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <2>;
		vcc-supply = <&vcc_3v3_s3>;
	};
};

&spdif_tx2 {
	status = "okay";
};

&spi2 {
	assigned-clocks = <&cru CLK_SPI2>;
	assigned-clock-rates = <200000000>;
	num-cs = <2>;
	status = "okay";

	pmic@0 {
		compatible = "rockchip,rk806";
		reg = <0x0>;
		#gpio-cells = <2>;
		gpio-controller;
		interrupt-parent = <&gpio0>;
		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_pins>, <&rk806_dvs1_null>,
			    <&rk806_dvs2_null>, <&rk806_dvs3_null>;
		spi-max-frequency = <1000000>;
		system-power-controller;

		vcc1-supply = <&vcc5v0_sys>;
		vcc2-supply = <&vcc5v0_sys>;
		vcc3-supply = <&vcc5v0_sys>;
		vcc4-supply = <&vcc5v0_sys>;
		vcc5-supply = <&vcc5v0_sys>;
		vcc6-supply = <&vcc5v0_sys>;
		vcc7-supply = <&vcc5v0_sys>;
		vcc8-supply = <&vcc5v0_sys>;
		vcc9-supply = <&vcc5v0_sys>;
		vcc10-supply = <&vcc5v0_sys>;
		vcc11-supply = <&vcc_2v0_pldo_s3>;
		vcc12-supply = <&vcc5v0_sys>;
		vcc13-supply = <&vcc5v0_sys>;
		vcc14-supply = <&vcc_1v1_nldo_s3>;
		vcca-supply = <&vcc5v0_sys>;

		rk806_dvs1_null: dvs1-null-pins {
			pins = "gpio_pwrctrl1";
			function = "pin_fun0";
		};

		rk806_dvs2_null: dvs2-null-pins {
			pins = "gpio_pwrctrl2";
			function = "pin_fun0";
		};

		rk806_dvs3_null: dvs3-null-pins {
			pins = "gpio_pwrctrl3";
			function = "pin_fun0";
		};

		regulators {
			vdd_gpu_s0: dcdc-reg1 {
				regulator-name = "vdd_gpu_s0";
				/* regulator coupling requires always-on */
				regulator-always-on;
				regulator-boot-on;
				regulator-enable-ramp-delay = <400>;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-coupled-with = <&vdd_gpu_mem_s0>;
				regulator-coupled-max-spread = <10000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_npu_s0: dcdc-reg2 {
				regulator-name = "vdd_npu_s0";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_log_s0: dcdc-reg3 {
				regulator-name = "vdd_log_s0";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <675000>;
				regulator-max-microvolt = <750000>;
				regulator-ramp-delay = <12500>;

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <750000>;
				};
			};

			vdd_vdenc_s0: dcdc-reg4 {
				regulator-name = "vdd_vdenc_s0";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_gpu_mem_s0: dcdc-reg5 {
				regulator-name = "vdd_gpu_mem_s0";
				/* regulator coupling requires always-on */
				regulator-always-on;
				regulator-boot-on;
				regulator-enable-ramp-delay = <400>;
				regulator-min-microvolt = <675000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-coupled-with = <&vdd_gpu_s0>;
				regulator-coupled-max-spread = <10000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_npu_mem_s0: dcdc-reg6 {
				regulator-name = "vdd_npu_mem_s0";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <675000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_2v0_pldo_s3: dcdc-reg7 {
				regulator-name = "vdd_2v0_pldo_s3";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <2000000>;
				regulator-max-microvolt = <2000000>;
				regulator-ramp-delay = <12500>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <2000000>;
				};
			};

			vdd_vdenc_mem_s0: dcdc-reg8 {
				regulator-name = "vdd_vdenc_mem_s0";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <675000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd2_ddr_s3: dcdc-reg9 {
				regulator-name = "vdd2_ddr_s3";
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_1v1_nldo_s3: dcdc-reg10 {
				regulator-name = "vcc_1v1_nldo_s3";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-ramp-delay = <12500>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1100000>;
